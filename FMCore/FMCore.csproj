<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>FMCore</AssemblyName>
    <RootNamespace>FMCore</RootNamespace>
    <Version>2.0.1</Version>
    <PackageId>FocusMinecraftCore</PackageId>
    <Title>FocusMinecraftCore</Title>
    <Authors>Voltucit</Authors>
    <Description>Minecraft Java 版启动核心；2.0.1。</Description>
    <RepositoryUrl>https://github.com/Voltucit/FocusMinecraftCore</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Voltucit/FocusMinecraftCore</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>nuget-readme.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FMCore.Tests" />
    <InternalsVisibleTo Include="FMCore.Cli" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.91.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../docs/nuget-readme.md" Pack="true" PackagePath="" />
    <None Include="../LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
