<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>FMCore：面向 .NET 10 / Windows 启动器开发者的 Minecraft Java 版 SDK，提供下载、版本、Java Runtime、安装、账号、启动、加载器、Mod 与整合包 API。</Description>
    <PackageId>FocusMinecraftCore</PackageId>
    <Version>1.0.0</Version>
    <PackageVersion>1.0.0</PackageVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Title>FocusMinecraftCore (FMCore)</Title>
    <Authors>Voltucit</Authors>
    <Copyright>Copyright (c) 2026 Voltucit</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Voltucit/FocusMinecraftCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Voltucit/FocusMinecraftCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>minecraft;launcher;dotnet;sdk</PackageTags>
    <PackageReleaseNotes>1.0.0 正式版：下载与校验、版本与 Java Runtime、游戏安装、Microsoft/离线账号、启动、实例、加载器、Mod 与整合包管理。兼容性和真实验证范围见 README、CHANGELOG 与模块手册。</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <EnablePackageValidation>true</EnablePackageValidation>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Legacy model members are documented incrementally; new SDK entry points include XML summaries. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../NOTICE.md" Pack="true" PackagePath="/" />
    <None Include="../CHANGELOG.md" Pack="true" PackagePath="/" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <InternalsVisibleTo Include="FMCore.Tests" />
  </ItemGroup>
</Project>
